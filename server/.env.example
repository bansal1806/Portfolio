# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or local: mongodb://127.0.0.1:27017/portfolio)

# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173,https://your-portfolio.vercel.app

# Optional: Nodemailer email notifications (Gmail needs an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
NOTIFY_EMAIL=you@gmail.com
