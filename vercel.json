{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "portfolio-api": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "portfolio-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
